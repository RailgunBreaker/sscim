{
  "name": "sscim-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run snapshot && npm run docs",
    "dev": "vite",
    "snapshot": "node scripts/build-vault-snapshot.mjs && node scripts/build-landing-stats.mjs",
    "docs": "node scripts/build-doc-library.mjs",
    "prebuild": "npm run snapshot && npm run docs",
    "build": "vite build",
    "postbuild": "npm run docs:pages",
    "preview": "vite preview",
    "audit:data": "node scripts/audit-snapshot.mjs",
    "test": "vitest run",
    "verify": "npm run audit:data && npm run docs:verify && npm test",
    "verify:all": "node scripts/verify-all.mjs",
    "docs:generate": "node scripts/build-doc-generated.mjs",
    "docs:verify": "node scripts/verify-docs.mjs",
    "docs:pages": "node scripts/build-doc-pages.mjs",
    "demo": "node scripts/build-computation-demo.mjs",
    "sensitivity": "node scripts/build-sensitivity.mjs",
    "benchmark": "node scripts/build-v6-v7-benchmark.mjs",
    "recovery": "node ../docs/computation-demo/validation/mle-validation.mjs",
    "smoke": "node scripts/browser-smoke.mjs",
    "stats": "node scripts/build-landing-stats.mjs"
  },
  "dependencies": {
    "katex": "^0.16.9",
    "leaflet": "^1.9.4",
    "marked": "^18.0.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^25.0.1",
    "vite": "^5.4.0",
    "vitest": "^2.1.9",
    "playwright-core": "^1.62.1"
  }
}
