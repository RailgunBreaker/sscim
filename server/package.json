{
  "name": "sscim-server",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.7.2",
  "type": "module",
  "scripts": {
    "dev": "node src/index.js",
    "start": "node src/index.js",
    "seed": "node src/seed.js",
    "pipeline": "node scripts/pipeline.mjs",
    "pipeline:dry": "node scripts/pipeline.mjs --dry-run",
    "review": "node scripts/review.mjs",
    "draft": "node scripts/draft-candidates.mjs",
    "sync": "node scripts/sync-events.mjs",
    "sync:facilities": "node scripts/sync-facilities.mjs",
    "quotes": "node scripts/fetch-quotes.mjs",
    "sync:countries": "node scripts/sync-countries.mjs",
    "api:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/restart-api.ps1",
    "sources": "node scripts/build-source-register.mjs && node scripts/build-evidence-coverage.mjs",
    "sources:resolve": "node scripts/resolve-citations.mjs",
    "sources:propose": "node scripts/resolve-citations.mjs --propose",
    "sources:sec": "node scripts/resolve-sec-citations.mjs",
    "sources:methods": "node scripts/resolve-method-citations.mjs",
    "evidence": "node scripts/build-evidence-coverage.mjs",
    "repair:provenance": "node scripts/repair-event-provenance.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "express": "^4.19.2"
  }
}
