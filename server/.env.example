PORT=8787
# Bearer token required for write access under /api/admin/*.
# Generate one yourself, e.g.: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=changeme

# --- Data pipeline (scripts/pipeline.mjs) ---
# Anthropic key for the AI drafting step. Without it the pipeline still runs;
# candidates are just queued undrafted for manual review. Never commit the real
# value — .env is gitignored, .env.example is not.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5)
# SSCIM_AI_MODEL=claude-opus-5

# webz.io news feed token (free tier). Where most supply-chain events surface.
WEBZ_TOKEN=

# --- Review queue triage (src/triage.js) ---
# Most feed records are not supply-chain events. Triage acts on the clear-cut
# ones so the queue a human opens holds only what is genuinely undecided.
#
# AUTO-REJECT is ON by default: the drafter judged it not an event, above Low
# confidence. A wrongly rejected candidate stays in the queue with its reason
# attached and costs one glance to recover.
# SSCIM_TRIAGE_AUTO_REJECT=on
#
# AUTO-APPROVE is OPT-IN and OFF by default. It writes to `events` and appends
# to app/src/engine/event-assumptions.js with nobody in the loop, which is a
# real change to the property that event semantics are hand-curated — so
# nothing enables it implicitly. Leave this unset and every relevant candidate
# waits for a person.
#
# Set it to "on" (an allow-list, so a typo fails safe) for bounded unattended
# approval: High confidence only, no duplicate flag, never without a draft.
# Anything it approves is recorded with provenance='automatic', says
# "automatically approved by triage — not human-reviewed" in its published
# source line, is stamped reviewed_by='auto-triage', and is reversible via
# POST /api/admin/review/auto/<id>/undo. No reviewer identity is ever invented.
#
#   SELECT * FROM events WHERE provenance='automatic';
#
# is the complete list of what went in that way.
# SSCIM_TRIAGE_AUTO_APPROVE=on

# --- API access control (src/middleware/) ---
# CORS is an allowlist, not a wildcard. localhost and 127.0.0.1 on any port are
# ALWAYS allowed, so local development needs nothing here. Add a tunnel or a
# deployed front end below, comma-separated. Requests with no Origin header
# (curl, the pipeline, health checks) always pass — those are not browser
# cross-origin requests and CORS has nothing to say about them.
# SSCIM_ALLOWED_ORIGINS=https://sscim.example.org,https://your-tunnel.example.dev
#
# Restores the old Access-Control-Allow-Origin: * behaviour. Logs a warning at
# startup so it cannot be on by accident and forgotten.
# SSCIM_ALLOW_ALL_ORIGINS=off

# Authenticated WRITES to /api/admin/* are rate-limited per credential. Reads
# are not, because the admin dashboard polls them. This does not replace
# ADMIN_TOKEN; it bounds what a leaked token or a runaway script can do per
# minute on paths that insert events and can trigger a git publish.
# SSCIM_ADMIN_RATE_LIMIT=on
# SSCIM_ADMIN_RATE_MAX=60
# SSCIM_ADMIN_RATE_WINDOW_MS=60000

# Candidates per Claude Code invocation. One call for the whole queue is
# all-or-nothing — a single timeout leaves every record undrafted — while one
# call each pays the large system context per record. Default 8.
# SSCIM_AI_CHUNK=8

# --- Publication after review (src/review-queue.js) ---
# Review decisions publish themselves: each one arms an idle timer, and the
# batch is committed and pushed once you stop deciding — or immediately once the
# queue empties. One commit per review session, without anyone pressing a
# button. Set to "off" to require the explicit Publish action instead.
# REVIEW_AUTOPUBLISH=on
# Idle window in milliseconds before the batch goes out (default 90000, min 5000).
# REVIEW_AUTOPUBLISH_IDLE_MS=90000
