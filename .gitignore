node_modules/
dist-app/
dist/
# The vault database (server/data/sscim.db) IS committed — it is the single
# source of truth the Pages build exports its static snapshot from. Only the
# transient WAL/journal sidecars stay untracked (npm run snapshot checkpoints
# the WAL into the .db before you commit).
server/data/*.db-journal
server/data/*.db-wal
server/data/*.db-shm
# Build artifact — regenerated from the database by app/scripts/build-vault-snapshot.mjs.
app/src/data/vault-snapshot.json
app/src/docs/generated-library.js
# Landing-page dataset figures, regenerated from the snapshot by
# app/scripts/build-landing-stats.mjs (runs as part of `npm run snapshot`).
app/src/landing/generated-stats.js
app/public/docs-manifest.json
.env
.env.local
.claude/

# API process logs written by scripts/restart-api.ps1
server/logs/

# Transient verification-run logs
app/*.log
